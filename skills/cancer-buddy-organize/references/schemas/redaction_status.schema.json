{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancerdao.org/schemas/cancer-buddy/redaction_status.schema.json",
  "title": "RedactionStatus",
  "description": "Live progress record for deterministic LLM-region source redaction. Written by scripts/run_redaction_job.py from redaction_manifest_v2. The script never performs OCR; it only applies LLM-supplied coordinates/structure locators, then waits for LLM QA before committing irreversible original deletion.",
  "type": "object",
  "required": ["schema", "patient_dir", "updated_at", "summary", "files"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "redaction_status_v2" },
    "patient_dir": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": ["total", "pending", "redacted_pending_qa", "done", "failed", "blocked"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "redacted_pending_qa": { "type": "integer", "minimum": 0 },
        "done": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_id",
          "status",
          "redacted_candidate_path",
          "redacted_path",
          "coverage_passed",
          "llm_qa_passed",
          "qa_report_id",
          "qa_passed",
          "original_deleted",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^f\\d{3,}$" },
          "source_id": { "type": "string", "pattern": "^s\\d{3,}$" },
          "status": { "type": "string", "enum": ["pending", "redacted_pending_qa", "done", "failed", "blocked"] },
          "redacted_candidate_path": { "type": ["string", "null"] },
          "redacted_path": { "type": ["string", "null"] },
          "coverage_passed": { "type": ["boolean", "null"] },
          "llm_qa_passed": { "type": ["boolean", "null"] },
          "qa_report_id": { "type": ["string", "null"] },
          "qa_passed": { "type": ["boolean", "null"] },
          "original_deleted": { "type": ["boolean", "null"] },
          "reason": { "type": ["string", "null"] }
        }
      }
    }
  }
}
