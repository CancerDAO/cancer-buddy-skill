{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancerdao.org/schemas/cancer-buddy/patient_summary.schema.json",
  "title": "PatientSummary",
  "description": "Source-preserving rollup. Extraction confidence is not clinical verification.",
  "type": "object",
  "required": ["patient_code", "schema_version", "generated_at", "demographics", "diagnosis", "current_status"],
  "additionalProperties": false,
  "properties": {
    "patient_code": { "type": "string", "pattern": "^PT-[A-F0-9]+(_\\d+)?$", "description": "Storage locator, not authentication." },
    "schema_version": { "const": "2" },
    "generated_at": { "type": "string", "format": "date-time" },
    "alias": { "type": ["string", "null"], "description": "Optional user-chosen non-clinical label; do not embed diagnosis or identifiers." },
    "demographics": {
      "type": "object",
      "required": ["sex", "sex_normalized", "age", "height_cm", "weight_kg", "ecog", "function_description", "provenance_layer", "verification_status", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "sex": { "type": ["string", "null"], "description": "Source wording." },
        "sex_normalized": { "type": ["string", "null"], "enum": ["female", "male", "intersex", "other", "unknown", null] },
        "age": { "type": ["integer", "null"], "minimum": 0, "maximum": 130 },
        "height_cm": { "type": ["number", "null"] },
        "weight_kg": { "type": ["number", "null"] },
        "ecog": { "type": ["integer", "null"], "minimum": 0, "maximum": 5, "description": "Clinician-reported only; never inferred." },
        "function_description": { "type": ["string", "null"], "description": "Patient/caregiver description kept separate from ECOG." },
        "provenance_layer": { "$ref": "#/$defs/provenance_layer" },
        "verification_status": { "$ref": "#/$defs/verification_status" },
        "source_refs": { "$ref": "#/$defs/source_refs" }
      }
    },
    "diagnosis": {
      "type": "object",
      "required": ["primary", "histology", "icd10", "diagnosed_at", "stage", "metastasis_sites", "provenance_layer", "verification_status", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "primary": { "type": ["string", "null"] },
        "histology": { "type": ["string", "null"] },
        "icd10": { "type": ["string", "null"] },
        "diagnosed_at": { "type": ["string", "null"], "format": "date" },
        "stage": { "type": ["string", "null"], "description": "Verbatim clinician/source stage; never recomputed." },
        "metastasis_sites": { "type": "array", "items": { "type": "string" } },
        "provenance_layer": { "$ref": "#/$defs/provenance_layer" },
        "verification_status": { "$ref": "#/$defs/verification_status" },
        "source_refs": { "$ref": "#/$defs/source_refs" }
      }
    },
    "current_status": {
      "type": "object",
      "required": ["regimen", "response", "ecog", "as_of", "provenance_layer", "verification_status", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "regimen": { "type": ["string", "null"] },
        "response": { "type": ["string", "null"], "description": "Clinician-reported response only; never calculated." },
        "ecog": { "type": ["integer", "null"], "minimum": 0, "maximum": 5, "description": "Clinician-reported only." },
        "as_of": { "type": ["string", "null"], "format": "date" },
        "provenance_layer": { "$ref": "#/$defs/provenance_layer" },
        "verification_status": { "$ref": "#/$defs/verification_status" },
        "source_refs": { "$ref": "#/$defs/source_refs" }
      }
    },
    "longitudinal_observations_ref": { "type": ["string", "null"], "description": "Neutral observations, not a response trajectory." },
    "treating_hospitals": { "type": "array", "items": { "type": "string" } },
    "extraction_confidence": {
      "type": "object",
      "description": "Technical extraction confidence only; not diagnostic confidence.",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  },
  "$defs": {
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "provenance_layer": { "enum": ["source_reported", "patient_reported", "caregiver_reported", "system_normalized"] },
    "verification_status": { "enum": ["unverified", "clinician_verified", "disputed"] }
  }
}
