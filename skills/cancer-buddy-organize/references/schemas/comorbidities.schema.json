{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancerdao.org/schemas/cancer-buddy/comorbidities.schema.json",
  "title": "ComorbiditiesMedicationsAllergies",
  "type": "object",
  "required": ["patient_code", "schema_version", "conditions", "medications", "allergies"],
  "additionalProperties": false,
  "properties": {
    "patient_code": { "type": "string", "pattern": "^PT-[A-F0-9]+(_\\d+)?$" },
    "schema_version": { "const": "2" },
    "generated_at": { "type": "string", "format": "date-time" },
    "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
    "medications": { "type": "array", "items": { "$ref": "#/$defs/medication" } },
    "allergies": { "type": "array", "items": { "$ref": "#/$defs/allergy" } }
  },
  "$defs": {
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "provenance": { "enum": ["source_reported", "patient_reported", "caregiver_reported", "system_normalized"] },
    "verification": { "enum": ["unverified", "clinician_verified", "disputed"] },
    "condition": {
      "type": "object", "required": ["name", "provenance_layer", "verification_status", "source_refs"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string" }, "icd10": { "type": ["string", "null"] },
        "onset": { "type": ["string", "null"], "format": "date" },
        "status_source": { "type": ["string", "null"] },
        "provenance_layer": { "$ref": "#/$defs/provenance" }, "verification_status": { "$ref": "#/$defs/verification" },
        "source_refs": { "$ref": "#/$defs/source_refs" }
      }
    },
    "medication": {
      "type": "object", "required": ["name", "use_status", "provenance_layer", "verification_status", "source_refs"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string" }, "normalized_name": { "type": ["string", "null"] },
        "dose": { "type": ["string", "null"] }, "frequency": { "type": ["string", "null"] },
        "route": { "type": ["string", "null"] }, "indication_source": { "type": ["string", "null"] },
        "use_status": { "enum": ["active_confirmed", "active_reported", "historical", "stopped", "unknown"] },
        "as_of": { "type": ["string", "null"], "format": "date" },
        "provenance_layer": { "$ref": "#/$defs/provenance" }, "verification_status": { "$ref": "#/$defs/verification" },
        "source_refs": { "$ref": "#/$defs/source_refs" }
      }
    },
    "allergy": {
      "type": "object", "required": ["allergen", "provenance_layer", "verification_status", "source_refs"], "additionalProperties": false,
      "properties": {
        "allergen": { "type": "string" }, "reaction": { "type": ["string", "null"] },
        "severity_source": { "type": ["string", "null"] }, "occurred_at": { "type": ["string", "null"] },
        "certainty_source": { "type": ["string", "null"] },
        "provenance_layer": { "$ref": "#/$defs/provenance" }, "verification_status": { "$ref": "#/$defs/verification" },
        "source_refs": { "$ref": "#/$defs/source_refs" }
      }
    }
  }
}
