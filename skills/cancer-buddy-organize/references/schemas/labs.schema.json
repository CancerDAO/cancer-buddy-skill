{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancerdao.org/schemas/cancer-buddy/labs.schema.json",
  "title": "Labs",
  "description": "Source-preserving laboratory observations. Clinical grading and treatment decisions are out of scope.",
  "type": "object",
  "required": ["patient_code", "schema_version", "panels"],
  "additionalProperties": false,
  "properties": {
    "patient_code": { "type": "string", "pattern": "^PT-[A-F0-9]+(_\\d+)?$" },
    "schema_version": { "const": "2" },
    "generated_at": { "type": "string", "format": "date-time" },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["analyte", "values"],
        "additionalProperties": false,
        "properties": {
          "analyte": { "type": "string", "description": "Analyte label as reported." },
          "normalized_analyte": { "type": ["string", "null"], "description": "Validated additive normalization; never replaces analyte." },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "date_kind", "value", "raw_value", "unit", "reference_range", "report_flag", "critical_flag", "source_refs", "provenance_layer", "verification_status"],
              "additionalProperties": false,
              "properties": {
                "date": { "type": "string", "format": "date" },
                "date_kind": { "enum": ["collected", "reported", "unknown"] },
                "value": { "type": ["number", "string", "null"], "description": "Value exactly as represented after faithful extraction." },
                "raw_value": { "type": ["string", "null"], "description": "Source string including inequality/qualifier where present." },
                "unit": { "type": ["string", "null"] },
                "reference_range": { "type": ["string", "null"], "description": "Range printed on this exact report/result; never reused across dates." },
                "report_flag": { "type": ["string", "null"], "description": "Flag printed by the reporting laboratory; not model-generated." },
                "critical_flag": { "type": ["string", "null"], "description": "Critical-value notation printed by the laboratory, if any." },
                "method": { "type": ["string", "null"] },
                "provenance_layer": { "enum": ["source_reported", "patient_reported", "caregiver_reported", "system_normalized"] },
                "verification_status": { "enum": ["unverified", "clinician_verified", "disputed"] },
                "source_refs": { "$ref": "#/$defs/source_refs" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
