{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancerdao.org/schemas/cancer-buddy/source_redaction_status.schema.json",
  "title": "SourceRedactionStatus",
  "description": "Pre-persist source-file redaction status for every source file selected for archive/persist. Persisted source files must be redacted by LLM-supplied region/structure locators, deterministic coverage-checked, LLM-QA-passed, and have their plaintext originals deleted.",
  "type": "object",
  "required": ["schema", "patient_dir", "updated_at", "summary", "files"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "source_redaction_status_v1" },
    "patient_dir": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": ["total", "pending", "done", "failed", "blocked", "not_required"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "done": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "not_required": { "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "status",
          "qa_passed",
          "original_deleted",
          "coverage_passed",
          "llm_qa_passed"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^s\\d{3,}$" },
          "status": { "type": "string", "enum": ["pending", "done", "failed", "blocked", "not_required"] },
          "strategy": {
            "type": ["string", "null"],
            "enum": ["llm_region_image", "llm_region_pdf", "llm_structured_docx", "llm_structured_sheet", "llm_text_rewrite", "archive_rebuild", "not_required", "blocked_unsupported", null]
          },
          "redacted_path": { "type": ["string", "null"] },
          "qa_passed": { "type": ["boolean", "null"] },
          "coverage_passed": { "type": ["boolean", "null"] },
          "llm_qa_passed": { "type": ["boolean", "null"] },
          "qa_report_id": { "type": ["string", "null"] },
          "original_deleted": { "type": ["boolean", "null"] },
          "reason": { "type": ["string", "null"] },
          "linked_redaction_manifest_id": {
            "type": ["string", "null"],
            "pattern": "^f\\d{3,}$"
          }
        }
      }
    }
  }
}
