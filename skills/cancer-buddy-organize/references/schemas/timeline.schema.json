{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancerdao.org/schemas/cancer-buddy/timeline.schema.json",
  "title": "Timeline",
  "description": "Versioned clinical and patient-reported events with explicit provenance.",
  "type": "object",
  "required": ["patient_code", "schema_version", "events"],
  "additionalProperties": false,
  "properties": {
    "patient_code": { "type": "string", "pattern": "^PT-[A-F0-9]+(_\\d+)?$" },
    "schema_version": { "const": "2" },
    "generated_at": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "date", "category", "title", "provenance_layer", "verification_status", "source_refs"],
        "additionalProperties": false,
        "properties": {
          "event_id": { "type": "string" },
          "date": { "type": "string", "description": "ISO date when exact; partial/uncertain date kept as source text." },
          "date_precision": { "enum": ["day", "month", "year", "approximate", "unknown"] },
          "category": { "enum": ["diagnosis", "procedure", "systemic_therapy", "radiation", "molecular_test", "imaging", "lab", "hospitalization", "consult", "symptom_report", "other"] },
          "title": { "type": "string" },
          "detail": { "type": ["string", "null"] },
          "institution": { "type": ["string", "null"] },
          "provenance_layer": { "enum": ["source_reported", "patient_reported", "caregiver_reported", "system_normalized"] },
          "verification_status": { "enum": ["unverified", "clinician_verified", "disputed", "withdrawn"] },
          "supersedes_event_id": { "type": ["string", "null"], "description": "Correction link; original event remains." },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
