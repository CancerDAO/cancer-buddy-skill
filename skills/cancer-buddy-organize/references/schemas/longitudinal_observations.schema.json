{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancerdao.org/schemas/cancer-buddy/longitudinal_observations.schema.json",
  "title": "LongitudinalObservations",
  "description": "Neutral longitudinal observations. A series is not a treatment-response trajectory.",
  "type": "object",
  "required": ["schema_version", "patient_code", "observations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "longitudinal_observations_v2" },
    "patient_code": { "type": "string", "pattern": "^PT-[A-F0-9]+(_\\d+)?$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["obs_type", "metric", "value", "timestamp", "source_ref", "provenance_layer", "verification_status"],
        "additionalProperties": false,
        "properties": {
          "obs_type": { "enum": ["vital", "lab", "symptom", "pro", "adherence", "activity", "clinician_function_score"] },
          "metric": { "type": "string" },
          "value": { "type": ["number", "string"] },
          "unit": { "type": ["string", "null"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "method_or_device": { "type": ["string", "null"] },
          "reference_range": { "type": ["string", "null"] },
          "provenance_layer": { "enum": ["source_reported", "patient_reported", "caregiver_reported", "system_normalized"] },
          "verification_status": { "enum": ["unverified", "clinician_verified", "disputed"] },
          "source_ref": { "type": "string" }
        }
      }
    }
  }
}
