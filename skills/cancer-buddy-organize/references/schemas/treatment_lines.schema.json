{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancerdao.org/schemas/cancer-buddy/treatment_lines.schema.json",
  "title": "TreatmentEpisodes",
  "description": "Source-reported treatment episodes. Line numbers are copied only when explicitly documented.",
  "type": "object",
  "required": ["patient_code", "schema_version", "episodes"],
  "additionalProperties": false,
  "properties": {
    "patient_code": { "type": "string", "pattern": "^PT-[A-F0-9]+(_\\d+)?$" },
    "schema_version": { "const": "2" },
    "generated_at": { "type": "string", "format": "date-time" },
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["episode_id", "sequence_index", "regimen", "source_refs", "provenance_layer", "verification_status"],
        "additionalProperties": false,
        "properties": {
          "episode_id": { "type": "string" },
          "sequence_index": { "type": "integer", "minimum": 0, "description": "Chronological ordering only; not a clinical line number." },
          "documented_line_label": { "type": ["string", "null"], "description": "Verbatim line wording only if a clinician source states it." },
          "phase_or_intent_source": { "type": ["string", "null"], "description": "Verbatim adjuvant/neoadjuvant/maintenance/consolidation/etc. wording; no inference." },
          "regimen": { "type": "string" },
          "started_at": { "type": ["string", "null"], "format": "date" },
          "ended_at": { "type": ["string", "null"], "format": "date" },
          "clinician_reported_response": { "type": ["string", "null"], "description": "Copied from clinician source; never calculated." },
          "reason_for_change_source": { "type": ["string", "null"] },
          "provenance_layer": { "enum": ["source_reported", "patient_reported", "caregiver_reported", "system_normalized"] },
          "verification_status": { "enum": ["unverified", "clinician_verified", "disputed"] },
          "source_refs": { "$ref": "#/$defs/source_refs" }
        }
      }
    }
  },
  "$defs": { "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
}
