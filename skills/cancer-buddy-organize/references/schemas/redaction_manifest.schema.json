{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancerdao.org/schemas/cancer-buddy/redaction_manifest.schema.json",
  "title": "RedactionManifest",
  "description": "Full-format source redaction handoff from Phase 1/2 to the deterministic region redactor. The LLM supplies redacted Markdown plus PII region metadata; this manifest carries only category + coordinates/structure locators, never plaintext PII. The redactor consumes it before archive/persist and never performs OCR.",
  "type": "object",
  "required": ["schema", "patient_dir", "generated_at", "files"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "redaction_manifest_v2" },
    "patient_dir": {
      "type": "string",
      "description": "Absolute path to <patient_dir>. All file paths below are relative to this directory."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when phase2-synthesis emitted this manifest."
    },
    "files": {
      "type": "array",
      "description": "One entry per source file selected for persist and requiring body redaction.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_id",
          "source_kind",
          "bucket_path",
          "mirror_path",
          "redacted_candidate_path",
          "adapter_frame",
          "regions",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^f\\d{3,}$",
            "description": "Stable per-file redaction id, e.g. f001. Joined by redaction_status.json files[].id."
          },
          "source_id": {
            "type": "string",
            "pattern": "^s\\d{3,}$",
            "description": "Matches source_inventory.json files[].source_id."
          },
          "source_kind": {
            "type": "string",
            "enum": ["image", "pdf", "docx", "xlsx", "csv", "txt", "html", "md", "archive", "other"]
          },
          "bucket_path": {
            "type": "string",
            "pattern": "^[^/].+",
            "description": "Bucket-relative canonical source path. Never absolute."
          },
          "mirror_path": {
            "type": "string",
            "pattern": "^10_原始文件/.+",
            "description": "Patient-dir-relative staging mirror path. Replaced only after QA passes."
          },
          "redacted_candidate_path": {
            "type": ["string", "null"],
            "description": "Patient-dir-relative candidate path written by prepare mode. Null in the initial manifest."
          },
          "redacted_payload_path": {
            "type": ["string", "null"],
            "description": "Optional patient-dir-relative LLM-redacted payload for text-like formats when region locators are not sufficient. It must already be PII-free."
          },
          "adapter_frame": {
            "type": "object",
            "required": ["frame_kind", "coordinate_space"],
            "additionalProperties": false,
            "properties": {
              "frame_kind": {
                "type": "string",
                "enum": ["image", "pdf_page", "docx_xml", "xlsx_sheet", "text", "archive_child", "none"]
              },
              "coordinate_space": {
                "type": "string",
                "enum": ["normalized_0_1", "pixel", "xml_locator", "cell", "line_span", "payload", "none"]
              },
              "width": { "type": ["number", "null"], "minimum": 0 },
              "height": { "type": ["number", "null"], "minimum": 0 },
              "dpi": { "type": ["number", "null"], "minimum": 0 },
              "page_count": { "type": ["integer", "null"], "minimum": 0 },
              "notes": { "type": ["string", "null"] }
            }
          },
          "regions": {
            "type": "array",
            "description": "PII regions or structure locators identified by the LLM. Do not store plaintext PII in any field.",
            "items": {
              "type": "object",
              "required": ["region_id", "category", "locator_type", "locator"],
              "additionalProperties": false,
              "properties": {
                "region_id": {
                  "type": "string",
                  "pattern": "^r\\d{3,}$"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "patient_name",
                    "patient_id",
                    "admission_id",
                    "bed_no",
                    "phone",
                    "address",
                    "id_card",
                    "birth_date",
                    "signature_name",
                    "hospital_exact",
                    "other"
                  ]
                },
                "locator_type": {
                  "type": "string",
                  "enum": [
                    "normalized_bbox",
                    "normalized_quad",
                    "pixel_bbox",
                    "page_normalized_bbox",
                    "page_normalized_quad",
                    "xml_path",
                    "cell",
                    "line_span",
                    "redacted_payload"
                  ]
                },
                "locator": {
                  "type": "object",
                  "description": "Shape depends on locator_type. Coordinate locators use x/y/w/h or quad points; structure locators use part/path/cell/line/span. No plaintext PII allowed.",
                  "additionalProperties": true
                },
                "confidence": {
                  "type": ["number", "string", "null"],
                  "description": "Optional confidence from the LLM, either numeric 0..1 or low/medium/high."
                }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["pending", "blocked"],
            "description": "Manifest is the initial work queue. Live progress is tracked in redaction_status.json."
          }
        }
      }
    }
  }
}
