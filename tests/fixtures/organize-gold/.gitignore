# The gold set itself is assembled locally from a de-identified copy and is NEVER
# committed. De-identification is not anonymity, and an accuracy fixture is not a
# shareable corpus. Only this directory's README, .gitignore and SYNTHETIC-example/
# belong in git.
*
!.gitignore
!README.md
!eval_transcription.py
!SYNTHETIC-example/
!SYNTHETIC-example/**

# …and not even inside SYNTHETIC-example: the PDF is generated by make_fixture.py, so
# no binary enters git and the page can never drift from the script that defines it.
SYNTHETIC-example/*.pdf
SYNTHETIC-example/*.png
